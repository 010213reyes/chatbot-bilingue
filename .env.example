# Configuración del Chatbot Bilingüe

# Nivel de logging
LOG_LEVEL=INFO

# Modo de ejecución (desarrollo o producción)
ENVIRONMENT=development

# Base de datos
DB_PATH=data/chatbot.sqlite3

# Ruta de datos
DATA_PATH=data

# API (futuro)
API_PORT=5000
API_HOST=127.0.0.1

# Modelo de red neuronal
MODEL_PATH=models/trained/level_classifier.h5
